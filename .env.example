# Local-only bind settings used by the Windows startup scripts.
PAGEGLANCE_HOST=127.0.0.1
PAGEGLANCE_PORT=8000
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_COMPLETION_TOKENS=1024
PAGEGLANCE_CONTEXT_MAX_CHARS=16000
PAGEGLANCE_HISTORY_MAX_MESSAGES=10
PAGEGLANCE_HISTORY_MAX_CHARS=12000
