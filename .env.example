# Local-only bind settings used by the Windows startup scripts.
PAGEGLANCE_HOST=127.0.0.1
PAGEGLANCE_PORT=8000
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_COMPLETION_TOKENS=1024
PAGEGLANCE_CONTEXT_MAX_CHARS=16000
PAGEGLANCE_HISTORY_MAX_MESSAGES=10
PAGEGLANCE_HISTORY_MAX_CHARS=12000
DATABASE_URL=postgresql+psycopg://pageglance:replace_me@127.0.0.1:5432/pageglance
PAGEGLANCE_EMBEDDING_PROVIDER=sentence_transformers
PAGEGLANCE_LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
PAGEGLANCE_EMBEDDING_BATCH_SIZE=64
# Optional path when Tesseract is not available on PATH (needed only for scanned PDF pages).
# PAGEGLANCE_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Used only when PAGEGLANCE_EMBEDDING_PROVIDER=openai (local inference needs no key).
PAGEGLANCE_EMBEDDING_TIMEOUT_SECONDS=30
PAGEGLANCE_EMBEDDING_MAX_RETRIES=3
PAGEGLANCE_RETRIEVAL_TOP_K=5
PAGEGLANCE_RETRIEVAL_MAX_TOP_K=50
PAGEGLANCE_RETRIEVAL_CANDIDATE_K=20
PAGEGLANCE_RETRIEVAL_MAX_CANDIDATE_K=200
PAGEGLANCE_RETRIEVAL_RRF_K=60
PAGEGLANCE_RERANKER_ENABLED=false
PAGEGLANCE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
PAGEGLANCE_RERANKER_CANDIDATE_K=20
# Optional, test-only URL. Use only a disposable local DB named pageglance_test.
# Tests read PAGEGLANCE_TEST_DATABASE_URL from the process environment, not this file.
# PAGEGLANCE_TEST_DATABASE_URL=postgresql+psycopg://pageglance_test:replace_me@127.0.0.1:5432/pageglance_test
