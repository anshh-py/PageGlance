{
  "manifest_version": 3,
  "name": "PageGlance",
  "version": "0.1.0",
  "description": "Ask questions about the webpage you are viewing.",
  "icons": {
    "16": "icons/pageglance-16.png",
    "32": "icons/pageglance-32.png",
    "48": "icons/pageglance-48.png",
    "128": "icons/pageglance-128.png"
  },
  "action": {
    "default_title": "Ask PageGlance",
    "default_popup": "index.html",
    "default_icon": {
      "16": "icons/pageglance-16.png",
      "32": "icons/pageglance-32.png"
    }
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ]
}
